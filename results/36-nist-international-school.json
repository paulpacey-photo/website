]], "skipped": [["[aria-hidden=\"true\"] @div.fsElement fsContainer slick-slide slick-#", 3719], ["nav @nav.#", 3026], ["[aria-hidden=\"true\"] @article.fsStyleAutoclear fsBoard-8 slick-slide s#", 2306], ["script @script.#", 1423], ["[aria-hidden=\"true\"] @article.fsStyleAutoclear fsBoard-7 fsTag-37 slic#", 1294], ["[role=menu] @ul.fsNavLevel2#", 827], ["[aria-hidden=\"true\"] @article.fsStyleAutoclear fsBoard-7 fsTag-7 fsTag#", 773], ["[aria-hidden=\"true\"] @div.fsElement fsContainer slick-slide#fsEl_4072", 486]], "sample": "", "role": "home"}, {"url": "https://www.nist.ac.th/about-nist/guiding-statements", "title": "Guiding Statements - NIST INTERNATIONAL SCHOOL in Bangkok, Thailand", "lang": "en-US", "vh": 900, "blocks": [[18, "a", -54, 1, 0, "Skip To Main Content"], [50, "h1", 408, 1, 0, "Guiding Statements"], [36, "h2", 972, 0, 0, "Values"], [28, "h3", 1105, 0, 0, "Integrity"], [16, "p", 1165, 0, 0, "We believe in being honest and principled, being committed to our mission and being accountable for our choices."], [28, "h3", 1105, 0, 0, "Caring"], [16, "p", 1165, 0, 0, "We believe in being compassionate and empathetic. Combined with reflection and balance, caring contributes to our wellbeing and growth."], [28, "h3", 1407, 0, 0, "Community"], [16, "p", 1466, 0, 0, "We believe in collaborating with others within a diverse community. Doing so helps us to become open-minded and globally aware."], [28, "h3", 1407, 0, 0, "Growth"], [16, "p", 1466, 0, 0, "We believe in working toward excellence through active and intentional engagement in all that we do."], [20, "h2", 1999, 0, 1, "Employment"], [18, "p", 2043, 0, 0, "NIST is a vibrant community made up of 500+ passionate and caring educators, experienced administrators, and dedicated operational staff who work as a team to provide a world-class education for our students."], [20, "h2", 1999, 0, 1, "Our Campus"], [18, "p", 2043, 0, 0, "Nestled in the heart of one of Bangkok’s busiest business districts, the NIST International School campus is located on Sukhumvit Soi 15, minutes from Asok BTS skytrain and Sukhumvit MRT subway stations. Our 25-rai campus encompasses ten buildings that house over 90 classrooms and state-of-the-art facilities."], [20, "h2", 1999, 0, 1, "Academic Performance"], [18, "p", 2043, 0, 0, "Each year our students excel in IB exams, posting scores well above the global averages, and often leading other schools in the region."]], "links": [["https://www.nist.ac.th/about-nist/guiding-statements", "Skip To Main Content"], ["https://www.nist.ac.th/about-nist", "About NIST"], ["https://www.nist.ac.th/about-nist", "About NIST"], ["https://www.nist.ac.th/about-nist/guiding-statements", "Guiding Statements"], ["https://www.nist.ac.th/about-nist/strategic-plan", "NIST Strategic Plan"], ["https://www.nist.ac.th/about-nist/our-history", "Our History"], ["https://www.nist.ac.th/about-nist/governance", "Governance"], ["https://www.nist.ac.th/about-nist/leadership", "School Leadership"], ["https://www.nist.ac.th/about-nist/academic-performance", "Academic Performance"], ["https://www.nist.ac.th/about-nist/academic-performance/nist-school-profile", "NIST School Profile"], ["https://www.nist.ac.th/about-nist/diversity-belonging-inclusion", "Diversity, Belonging & Inclusion"], ["https://www.nist.ac.th/about-nist/our-campus", "Our Campus"], ["https://www.nist.ac.th/about-nist/our-campus/phase-1", "Phase 1 - Innovation Building"], ["https://www.nist.ac.th/about-nist/our-campus/phase-2", "Phase 2 - Pavilion & Elementary Buildings"], ["https://www.nist.ac.th/about-nist/contact-us", "Contact Us"], ["https://www.nist.ac.th/about-nist", "About NIST"], ["https://www.nist.ac.th/about-nist", "About NIST"], ["https://www.nist.ac.th/about-nist/guiding-statements", "Guiding Statements"], ["https://www.nist.ac.th/about-nist/strategic-plan", "NIST Strategic Plan"], ["https://www.nist.ac.th/about-nist/our-history", "Our History"], ["https://www.nist.ac.th/about-nist/governance", "Governa