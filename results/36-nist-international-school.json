{"site": {"id": "36-nist-international-school", "name": "NIST International School", "type": "School", "country": "Thailand", "region": "Asia", "curriculum": "IB", "ownership": "Non-profit", "url": "https://www.nist.ac.th", "client": false}, "pages": [{"url": "https://www.nist.ac.th/", "title": "NIST International School Bangkok | Thailand’s First Full IB World School", "lang": "en-US", "vh": 900, "blocks": [[18, "a", -54, 1, 0, "Skip To Main Content"], [55, "div", 678, 1, 0, "Serving and learning from others"], [50, "h1", 899, 1, 0, "NIST International School Bangkok | Thailand’s First Full IB World School"], [36, "h2", 964, 0, 0, "NIST International School in Bangkok, Thailand Inspiring and Empowering Global Citizens"], [18, "p", 1070, 0, 0, "We empower global citizens through the NIST learning programme, grounded in the full IB Continuum and enriched by wellbeing, activities, service learning, and expeditions. As a leading international school in Thailand, our student-centred approach sparks curiosity, nurtures individual interests, and inspires a passion for lifelong learning within a truly diverse community. We prepare students to flourish at the world’s top universities and make a positive impact on the world."], [60, "h2", 1403, 0, 1, "Inspire, Empower, Enrich"], [14, "p", 1350, 0, 1, "OUR PURPOSE"], [18, "p", 1505, 0, 0, "At NIST, we go beyond traditional education. We inspire curiosity and purposeful growth, empower students to pursue excellence with confidence, and enrich their lives through a holistic learning experience that prepares them to shape a better world."], [40, "div", 1826, 0, 0, "Academics"], [18, "p", 1899, 0, 0, "NIST, a leading educational institution in Thailand, offers the full range of International Baccalaureate (IB) programmes and a NIST Diploma. The concept-based curriculum integrates IB frameworks, NIST Attributes, and the UN Sustainable Development Goals, providing a comprehensive and well-rounded education. The Global Citizenship Diploma (GCD) is also offered to secondary students."], [12, "a", 2173, 0, 0, "LEARN MORE"], [12, "span", 2182, 0, 0, "about Academics"], [20, "p", 2988, 0, 0, "Thailand’s First Full IB World School"], [14, "p", 2548, 0, 1, "OUR PROGRAMMES"], [18, "p", 2737, 0, 0, "NIST International School is Thailand’s first not-for-profit school authorised to offer the full International Baccalaureate (IB) Continuum. Since 1999, we have provided a leading international education in Bangkok for students aged 3–19."], [18, "p", 2901, 0, 0, "Through the IB’s PYP MYP , and DP , students develop strong conceptual understanding, critical thinking, and the confidence to apply learning in real-world contexts. This globally recognised framework prepares students for success at the world’s top universities while nurturing internationally minded, compassionate individuals ready to make a meaningful contribution to the world."], [24, "h2", 3181, 0, 1, "Community of"], [60, "h3", 3230, 0, 1, "95+ Nationalities"], [60, "h2", 3816, 0, 1, "Creating an Oasis in the Heart of Bangkok"], [14, "p", 3764, 0, 1, "OUR CAMPUS"], [20, "h2", 4204, 0, 1, "Our Campus"], [18, "p", 4248, 0, 0, "Revitalising our campus for enhanced learning, safety and belonging."], [20, "h2", 4204, 0, 1, "LOCATION"], [18, "p", 4248, 0, 0, "Conveniently located in Asok, Bangkok, NIST is easily accessible by taxi, BTS or MRT."], [20, "h2", 4204, 0, 1, "Community"], [18, "p", 4248, 0, 0, "A proudly diverse and welcoming community of over 90 nationalities."], [60, "h2", 4830, 0, 1, "NIST at a Glance"], [14, "p", 5186, 0, 0, "average IB Diploma score"], [14, "p", 5186, 0, 0, "home languages offered during the school day curriculum"], [58, "div", 5102, 0, 1, "63%"], [14, "p", 5186, 0, 0, "of students graduate with a bilingual diploma"], [14, "p", 5186, 0, 0, "nationalities in our school community"], [58, "div", 5595, 0, 1, "1,800+"], [14, "p", 5679, 0, 0, "students aged 3-18"], [58, "div", 5595, 0, 1, "98%"], [14, "p", 5679, 0, 0, "pass rate of IB Diploma candidates"], [14, "p", 5679, 0, 0, "student-led Service Groups"], [58, "div", 5595, 0, 1, "300+"], [14, "p", 5679, 0, 0, "activities offered throughout the year"], [60, "h2", 5995, 0, 1, "Our Voices"], [14, "p", 5943, 0, 1, "TESTIMONIALS"], [12, "div", 6904, 0, 0, "Dr. Darshil Shah"], [20, "p", 6885, 0, 0, "The education and combination of creative, practical and critical thinking skills I gained at NIST have played a pivotal role in shaping my professional journey."], [12, "div", 6904, 0, 0, "Daisy Gambles"], [20, "p", 6885, 0, 0, "I think that the exceptional teachers at NIST have had an indelible influence on my development as a person"], [12, "div", 6904, 0, 0, "Olivier Hildebrand"], [20, "p", 6885, 0, 0, "NIST nurtures global citizens through an interdisciplinary, modern and conscientious education environment that prepares us for the challenges of the future."], [36, "h2", 7139, 0, 0, "Connect with US"], [18, "div", 9087, 0, 0, "video loaded"]], "links": [["https://www.nist.ac.th/about-nist", "About NIST"], ["https://www.nist.ac.th/about-nist", "About NIST"], ["https://www.nist.ac.th/about-nist/guiding-statements", "Guiding Statements"], ["https://www.nist.ac.th/about-nist/strategic-plan", "NIST Strategic Plan"], ["https://www.nist.ac.th/about-nist/our-history", "Our History"], ["https://www.nist.ac.th/about-nist/governance", "Governance"], ["https://www.nist.ac.th/about-nist/leadership", "School Leadership"], ["https://www.nist.ac.th/about-nist/academic-performance", "Academic Performance"], ["https://www.nist.ac.th/about-nist/academic-performance/nist-school-profile", "NIST School Profile"], ["https://www.nist.ac.th/about-nist/diversity-belonging-inclusion", "Diversity, Belonging & Inclusion"], ["https://www.nist.ac.th/about-nist/our-campus", "Our Campus"], ["https://www.nist.ac.th/about-nist/our-campus/phase-1", "Phase 1 - Innovation Building"], ["https://www.nist.ac.th/about-nist/our-campus/phase-2", "Phase 2 - Pavilion & Elementary