18", ""], ["https://www.dubaicollege.org/about/55369679006", ""], ["https://www.dubaicollege.org/about/55369679006", ""], ["https://www.dubaicollege.org/about/55369824803", ""], ["https://www.dubaicollege.org/about/55369824803", ""], ["https://www.dubaicollege.org/about/55366768742", ""], ["https://www.dubaicollege.org/about/55366768742", ""]], "skipped": [["[aria-hidden=\"true\"] @li.feed-item j-flickr j-flickr-bg image-pos#", 3920], ["nav @nav.#", 2010], ["[aria-hidden=\"true\"] @div.fsNavPageInfo#", 1038], ["[role=menu] @ul.fsNavLevel2 menu-col column-1#", 710], ["button @button.expander#", 304], ["[role=menubar] @ul.fsNavLevel1#", 168], ["noscript @noscript.#", 139], ["[class*=\"footer\" i] @section.fsElement fsNavigation fsList footer-acr#fsEl_12861", 138]], "sample": "", "role": "sub", "link_label": "Vision & Values", "link_score": 3.5}, {"url": "https://www.dubaicollege.org/about", "title": "About us - Dubai College", "lang": "en-US", "vh": 900, "blocks": [[16, "a", -48, 1, 0, "Skip To Main Content"], [54, "h1", 690, 1, 0, "About us"], [38, "h2", 805, 1, 1, "Welcome"], [18, "p", 1582, 0, 0, "Welcome to Dubai College: an institution, much like the UAE itself, defined by ambition and the intention to develop a culture of unparalleled educational excellence"], [16, "p", 1676, 0, 0, "As one of the foremost independent schools globally, it is with great pride that I welcome you to our community of inspirational educators and aspirational students. Our young people are equipped to make a major impact in the world as they grow into adaptable, flexible, and globally aware individuals, defined by our core values of excellence, hard work, kindness, and integrity."], [16, "p", 1784, 0, 0, "We aim to provide a rich holistic education and academic excellence for our students. We exist to equip young people with the deep learning and good character that they will need to flourish in their lives."], [16, "p", 1870, 0, 0, "Our not-for-profit status ensures our unwavering commitment to prioritising students in every decision we make. We reinvest every dirham back into our students and school, an ethos that has enabled us to cultivate an outstanding and world-leading teaching and learning environment since 1977. This steadfast focus on tradition and institutional culture makes us the preferred choice for many of Dubai’s established families."], [30, "span", 2030, 0, 0, "Academically, Dubai College is recognised as one of the world’s highest achieving international schools, with academic excellence and a passion for profound knowledge as our core mission."], [16, "p", 2224, 0, 0, "However, our commitment extends beyond academics to the holistic development of all our students. Our reputation is built on consistent and sustained excellence across four key pillars: academic, sporting, creative, and philanthropic endeavours. While we place great importance on classroom success, we believe in fostering students’ growth through the richness of the diverse experiences our school offers. Our goal is for them to flourish as individuals, developing their character in an inspiring environment designed to promote intellectual, social, and personal growth in the areas of scholarship, entrepreneurship, innovation and sustainability."], [16, "p", 2398, 0, 0, "I firmly believe that education breeds confidence, confidence breeds hope, and hope breeds peace. This remains our goal as educators: to sculpt a future generation able to lead positive change to shape a better tomorrow. I remain humbled and inspired by the outstanding members of our community and welcome you to come and experience their enthusiasm and joy for learning first hand."], [16, "p", 2529, 0, 0, "Tomas Duckling, Headmaster"], [38, "h2", 2632, 0, 1, "Dubai College Flickr"], [38, "h2", 2232, 0, 1, "An introduction to Dubai College"], [16, "div", 2344, 0, 0, "There are no resources or collections to display"], [38, "h2", 2428, 0, 1, "@dubaicollege"]], "links": [["https://www.dubaicollege.or