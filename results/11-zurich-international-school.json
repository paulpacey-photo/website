#fsEl_35586", 2527]], "sample": "", "role": "home"}, {"url": "https://www.zis.ch/our-school/strategic-plan", "title": "Strategic Plan - ZIS | Zurich International School, Switzerland", "lang": "en-US", "vh": 900, "blocks": [[16, "a", -48, 1, 0, "Skip To Main Content"], [14, "p", 0, 1, 1, "Bilingual Pathway"], [50, "h1", 220, 1, 0, "MISSION"], [36, "p", 317, 1, 0, "We surface and inspire each learner's curiosity critical thinking , and high expectations for their learning so that they positively impact their family, community and the world."], [50, "h1", 500, 1, 0, "STRATEGIC FRAMEWORK"], [30, "p", 603, 1, 0, "Forward Together 2030 represents a defining moment. Shaped by the collective voices of our students, families, educators, staff, alumni, and board members, it provides a clear direction for the future while remaining deeply rooted in our values of Respect, Courage, Humility, and Joy"], [24, "h3", 1539, 0, 0, "Two Non-Negotiables"], [16, "p", 1588, 0, 0, "At the heart of our strategic framework are two commitments that will guide every decision we make:"], [24, "h3", 1650, 0, 0, "Non-Negotiable 1"], [19, "h4", 1699, 0, 0, "A Hub for Exceptional Teaching, Learning, and Leading"], [24, "h3", 1650, 0, 0, "Non-Negotiable 2"], [19, "h4", 1699, 0, 0, "A Cohesive EC-12 Learning Journey"], [16, "p", 1805, 0, 0, "To bring these commitments to life, we have identified five Strategic Priorities that will shape our work through 2030:"], [19, "h4", 1908, 0, 0, "High Expectations"], [19, "h4", 1888, 0, 0, "Elevated Language Program."], [19, "h4", 2058, 0, 0, "Exceptional educators and leaders."], [19, "h4", 2251, 0, 0, "Being Good Neighbors"], [19, "h4", 2251, 0, 0, "Our Story"], [16, "p", 2398, 0, 0, "These priorities emerged from a comprehensive strategic planning process conducted throughout the 2024–2025 school year. Through surveys, listening sessions, community conversations, accreditation feedback, and extensive stakeholder engagement, our community helped define a shared vision for the future of ZIS."], [20, "span", 2492, 0, 0, "To learn more about our two Non-Negotiables, our five Strategic Priorities, our aspirations, and the values that unite us as one community, please read our brochure, available in both English and German."], [24, "h3", 2602, 0, 1, "Strategic Framework (English)"], [16, "p", 3291, 0, 0, "Please accept the cookie consent"], [24, "h3", 2602, 0, 1, "Strategischer Rahmen (Deutsch)"], [13, "a", 862, 1, 0, "English"]], "links": [["https://www.zis.ch/our-school/strategic-plan", "Skip To Main Content"], ["https://www.zis.ch/our-school/welcome", "Our school"], ["https://www.zis.ch/our-school/welcome", "Welcome"], ["https://www.zis.ch/our-school/strategic-plan", "Mission and Strategic Framework"], ["https://www.zis.ch/our-school/transforming-learning-spaces", "Transforming Learning Spaces"], ["https://www.zis.ch/our-school/governance", "Leadership and Governance"], ["https://www.zis.ch/our-school/waedenswil-campus", "Wädenswil Campus (ages 3-11)"], ["https://www.zis.ch/our-school/adliswil-campus", "Adliswil Campus (ages 11-18)"], ["https://www.zis.ch/our-school/contacts", "Contacts & Directions"], ["https://www.zis.ch/our-school/calendar", "Calendar"], ["https://www.zis.ch/our-school/press", "News and Press Articles"], ["https://www.zis.ch/our-school/strategic-plan", "Bilingual Pathway"], ["https://www.zis.ch/our-school/welcome", "Our schoolexpand this section"], ["https://www.zis.ch/our-school/welcome", "Welcome"], ["https://www.zis.ch/our-school/strategic-plan", "Mission and Strategic Framework"], ["https://www.zis.ch/our-school/transforming-learning-spaces", "Transforming Learning Spacesexpand this section"], ["https://www.zis.ch/our-school/transforming-learning-spaces/deeper-learning", "Deeper learning"], ["https://www.zis.ch/our-school/transforming-learning-spaces/belonging-by-design", "Belonging by design"], ["https://www.zis.ch/our-school/transforming-learning-spaces/connected-learning", "Connected learning"]