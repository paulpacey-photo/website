Level2#", 702], ["button @button.expander#", 247], ["[class*=\"footer\" i] @div.fsElement fsContent footer-logo#fsEl_26975", 223], ["[class*=\"consent\" i] @div.cky-consent-bar#", 157], ["[class*=\"footer\" i] @div.fsElement fsLayout fsThreeColumnLayout f#fsEl_26969", 73]], "sample": "", "role": "sub", "link_label": "Mission and Strategic Framework", "link_score": 3.5}, {"url": "https://www.zis.ch/our-school/welcome", "title": "Zurich International School | Leading International & Bilingual School in Zurich", "lang": "en-US", "vh": 900, "blocks": [[16, "a", -48, 1, 0, "Skip To Main Content"], [14, "p", 0, 1, 1, "Bilingual Pathway"], [50, "h1", 220, 1, 0, "Welcome to Zurich International School"], [20, "span", 320, 1, 0, "Get to know us at our upcoming Open Houses"], [16, "p", 840, 1, 0, "Elsa Hernández-Donohue Director"], [16, "p", 400, 1, 0, "As a parent, I understand the hopes we all share for our children—to grow into kind, confident, curious young people who live with purpose. At ZIS, we share those hopes with every family."], [16, "p", 508, 1, 0, "Proudly international and deeply rooted in Switzerland, our community brings together students from more than 60 nationalities in an environment where they are inspired to think critically, embrace challenges, and develop a lifelong love of learning. Here, they discover who they are, what they value, and how they can make a positive impact on the world."], [16, "p", 682, 1, 0, "Learning at ZIS extends well beyond academics. We nurture character, wellbeing, resilience, and the confidence to thrive in a rapidly changing world. As a not-for-profit school, every resource is reinvested in delivering an exceptional educational experience for our students."], [16, "p", 812, 1, 0, "I invite you to visit our campus, experience our community, and discover what makes ZIS such a special place to learn and grow."], [16, "p", 898, 1, 0, "Warm regards,"], [16, "p", 940, 0, 0, "Elsa Hernández-Donohue School Director"], [35, "h2", 1172, 0, 0, "Meeting Students Where They Are"], [20, "span", 1264, 0, 0, "Small, close-knit communities are important for learning success. Our three age groups on two campuses allow our 1,300+ students to have an intimate, personalized learning experience at each stage of their journey"], [24, "h2", 1800, 0, 0, "Early Childhood to Grade 5 (ages 3-11)"], [24, "h3", 1878, 0, 0, "Wädenswil Camups"], [16, "p", 1927, 0, 0, "A nurturing foundation for early learning , play-based exploration, international and bilingual pathways and inquiry-driven primary education."], [16, "p", 2066, 0, 0, "Size: 400 students"], [16, "li", 2112, 0, 0, "Personalized learning pathways at each stage of development with individual learning technology provided"], [16, "li", 2199, 0, 0, "Bilingual Pathway in English/German from ages 3-11, expanding to Grade 9."], [16, "li", 2257, 0, 0, "Distinctive co-curricular activities and clubs after school"], [16, "li", 2315, 0, 0, "Purpose-built facility with age appropriate playgrounds"], [16, "li", 2373, 0, 0, "School bus service and access to public transport"], [19, "p", 2447, 0, 0, "Learn More"], [24, "h2", 1800, 0, 0, "Grades 6-8 (ages 11-14)"], [24, "h3", 1849, 0, 0, "Adliswil Campus"], [16, "p", 1898, 0, 0, "Supportive, relationship-focused learning designed for early adolescence, encouraging curiosity, independence and academic growth."], [16, "p", 2037, 0, 0, "Size: 340 students"], [16, "li", 2083, 0, 0, "Inquiry-based curriculum with the choice from a wide variety of classes"], [16, "li", 2141, 0, 0, "Individual learning technology provided"], [16, "li", 2170, 0, 0, "Distinctive co-curricular activities and after school clubs"], [16, "li", 2228, 0, 0, "Brand new facility opened in August 2022 including a media center, Design Lab, and theater, music and performance areas"], [16, "li", 2315, 0, 0, "Access to public transport"], [24, "h2", 1800, 0, 0, "Grades 9-12 (ages 14-18)"], [16, "p", 1898, 0, 0, "A rigorous international programme culminating in pathways such as the IB Diploma Programme and Advanced Placement , preparing students for universities worldwide."], [16, "p", 2066, 0, 0, "Size: 540 students"], [16, "li", 2112, 0, 0, "Flexible and rigorous curriculum pathways with technology integrated"], [16, "li", 2170, 0, 0, "Options from International Baccalaureate and Advanced Placement courses"], [16, "li", 2257, 0, 0, "Distinctive co-curricular program"], [16, "li", 2286, 0, 0, "Future pathway counselling and university application support"], [16, "li", 2344, 0, 0, "Modern campus with access to public transport"], [36, "p", 2605, 0, 0, "Take the first step"], [26, "p", 2668, 0, 0, "Discover Zurich International School"], [19, "p", 2666, 0, 0, "Connect with our Enrollment Team"], [13, "a", 862, 1, 0, "English"]], "links": [["https://www.zis.ch/our-school/welcome", "Skip To Main Content"], ["https://www.zis.ch/our-school/welcome", "Our school"], ["https://www.zis.ch/our-school/welcome", "Welcome"], ["https://www.zis.ch/our-school/strategic-plan", "Mission and Strategic Framework"], ["https://www.zis.ch/our-school/transforming-learning-spaces", "Transforming Learning Spaces"], ["https://www.zis.ch/our-school/governance", "Leadership and Governance"], ["https://www.zis.ch/our-school/waedenswil-campus", "Wädenswil Campus (ages 3-11)"], ["https://www.zis.ch/our-school/adliswil-campus", "Adliswil Campus (ages 11-18)"], ["https://www.zis.ch/our-school/contacts", "Contacts & Directions"], ["https://www.zis.ch/our-school/calendar", "Calendar"], ["https://www.zis.ch/our-school/press", "News and Press Articles"], ["https://www.zis.ch/our-school/welcome", "Bilingual Pathway"], ["https://www.zis.ch/our-school/welcome", "Our schoolexpand this section"], ["https://www.zis.ch/our-school/welcome", "Welcome"], ["https://www.zis.ch/our-school/strategic-plan", "Mission and Strategic Framework"], ["https://www.zis.ch/our-school/transforming-learning-spaces", "Transforming Learning Spacesexpand this section"], ["https://www.z