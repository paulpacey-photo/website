{"site": {"id": "15-frankfurt-international-school", "name": "Frankfurt International School", "type": "School", "country": "Germany", "region": "Europe", "curriculum": "IB", "ownership": "Non-profit", "url": "https://www.fis.edu", "client": false}, "pages": [{"url": "https://www.fis.edu/", "title": "Frankfurt International School: A World of Opportunities", "lang": "en-US", "vh": 900, "blocks": [[17, "a", -51, 1, 0, "Skip To Main Content"], [17, "a", 20, 1, 1, "Frankfurt International School"], [56, "h1", 899, 1, 0, "Home"], [36, "h2", 1020, 0, 1, "a place to"], [90, "strong", 1058, 0, 1, "explore"], [26, "p", 1030, 0, 1, "To meet the needs of students, families can choose between our two International Baccalaureate (IB) World campuses."], [30, "p", 1536, 0, 0, "OBERURSEL Preschool - Grade 12"], [30, "p", 1536, 0, 0, "WIESBADEN Preschool - Grade 8"], [90, "strong", 1810, 0, 1, "pursue your passion"], [36, "h2", 1997, 0, 0, "Be Creative"], [15, "a", 2085, 0, 0, "Explore Activities"], [18, "h2", 2201, 0, 1, "arts"], [36, "h2", 2446, 0, 1, "a place to find a"], [90, "strong", 2484, 0, 1, "welcoming home"], [26, "p", 2564, 0, 1, "We are a family-oriented community. The richness of our school is grounded in the way we actively involve everyone."], [30, "h2", 2928, 0, 0, "STUDENTS"], [30, "h2", 2929, 0, 0, "PARENTS"], [30, "h2", 2934, 0, 0, "FACULTY"], [30, "h2", 2944, 0, 0, "ALUMNI"], [36, "h2", 3117, 0, 1, "a place that's"], [90, "strong", 3155, 0, 1, "Unique"]], "links": [["https://www.fis.edu/about", "About"], ["https://www.fis.edu/about/who-we-are", "Discover FIS"], ["https://www.fis.edu/about/meet-our-leadership", "Meet Our Leadership"], ["https://www.fis.edu/about/boardoftrustees", "Meet Our Board"], ["https://www.fis.edu/about/where-we-are-headed", "Learn Where We're Headed"], ["https://www.fis.edu/about/safeguarding", "Safeguarding"], ["https://www.fis.edu/about/belonging", "Well-being and Belonging"], ["https://www.fis.edu/about/leaving-a-legacy", "Give to FIS"], ["https://www.fis.edu/about/our-campuses", "Tour Our Campuses"], ["https://www.fis.edu/about", "Aboutexpand this section"], ["https://www.fis.edu/about/who-we-are", "Discover FIS"], ["https://www.fis.edu/about/meet-our-leadership", "Meet Our Leadership"], ["https://www.fis.edu/about/boardoftrustees", "Meet Our Board"], ["https://www.fis.edu/about/where-we-are-headed", "Learn Where We're Headed"], ["https://www.fis.edu/about/safeguarding", "Safeguarding"], ["https://www.fis.edu/about/belonging", "Well-being and Belonging"], ["https://www.fis.edu/about/leaving-a-legacy", "Give to FIS"], ["https://www.fis.edu/about/our-campuses", "Tour Our Campuses"], ["https://www.fis.edu/about/our-campuses/fis-oberursel", ""], ["https://www.fis.edu/about/our-campuses/fis-wiesbaden", ""]], "skipped": [["nav @nav.#", 1261], ["script @script.#", 921], ["[role=menu] @ul.fsNavLevel2#", 777], ["dialog @dialog.fsDialog fsPagePopDialog#fsPagePopDialog", 577], ["[class*=\"footer\" i] @div.fsElementFooterContent#", 310], ["style @style.#", 254], ["[class*=\"footer\" i] @div.fsElement fsContainer footer-holder#fsEl_1493", 204], ["noscript @noscript.#", 139]], "sample": "", "role": "home"}, {"url": "https://www.fis.edu/about", "title": "About - Frankfurt International School", "lang": "en-US", "vh": 900, "blocks": [[17, "a", -51, 1, 0, "Skip To Main Content"], [17, "a", 20, 1, 1, "Frankfurt International School"], [36, "h2", 987, 0, 1, "welcome to"], [90, "strong", 1025, 0, 1, "frankfurt international school"], [17, "p", 1223, 0, 0, "At FIS, you will find a welcoming home in which to explore, have fun and think beyond yourself."], [17, "p", 1295, 0, 0, "While academic success is at the center of school life, the arts, sciences, humanities, language learning, life skills and athletics provide the foundation for our learning community."], [17, "p", 1393, 0, 0, "Our teaching and learning practices, rooted in the International Baccalaureate (IB), help students at all ages and grade levels make connections across academic disciplines and challenge them to achieve their highest potential as individuals – and as caring, ethical and adaptable global citizens."], [17, "p", 1517, 0, 0, "Shortly after opening our doors in 1961, FIS became a founding IB school, forging the path for the world-class program. Our Class of 2026 scored an average of 36 points on their IB exams, making FIS one of the few schools in Europe with such a high average."], [30, "h3", 1738, 0, 0, "Our Mission, Vision and values"], [17, "p", 1799, 0, 0, "FIS provides an education that opens pathways, inspires excellence and connects future-ready learners across cultures and communities. The cornerstones of our school's character are reflected in:"], [17, "p", 1871, 0, 0, "Our Mission: Extraordinary Education in a World of Opportunities"], [17, "p", 1917, 0, 0, "Our Vision: Empowering students to thrive in a dynamic world"], [17, "p", 1963, 0, 0, "And our Values: Aim High • Be Courageous • Engage Thoughtfully • Embrace Community"], [36, "h2", 2129, 0, 1, "Explore the"], [90, "strong", 2167, 0, 1, "Possibilities"], [30, "h2", 2503, 0, 0, "discover who we are"], [30, "h2", 2537, 0, 0, "hear our story"], [30, "h2", 2537, 0, 0, "tour our campuses"], [30, "h2", 2858, 0, 0, "learn where we're headed"], [30, "h2", 2892, 0, 0, "meet our leadership"], [30, "h2", 2858, 0, 0, "connect with our board"], [30, "h2", 3213, 0, 0, "Download our school profile"], [30, "h2", 3213, 0, 0, "Download Our annual report"], [30, "h2", 3247, 0, 0, "SEE our FIS Viewbook"], [56, "h2", 3416, 0, 1, "Top 10 Reasons to Consider FIS"], [38, "h2", 3543, 0, 0, "#10. endless opportunities to learn outside the classroom"], [26, "p", 3676, 0, 0, "Students have countless options to participate in arts, athletics, language learning, and service and leadership while at FIS. Faculty and staff forge lasting relationships and build solid networks through coaching or participating in after school activities."], [38, "h2", 4183, 0, 1, "FIS At a Glance"], [38, "h2", 4771, 0, 1, "Contact Us"], [18, "h4", 4829, 0, 0, "General Inquires:"], [17, "p", 4870, 0, 0, "Tel: +49 (0)6171 2024-0 Email: info@fis.edu"], [18, "h4", 4968, 0, 0, "Admissions:"], [17, "p", 5009, 0, 0, "Tel: +49 (0)6171 2024-474 Email: admissions@fis.edu Further admissions information can be found here on our website"], [18, "h4", 5107, 0, 0, "Further Contacts:"], [17, "p", 5148, 0, 0, "Further contacts for the school can be found here"]], "links": [["https://www.fis.edu/about", "Skip To Main Content"], ["https://www.fis.edu/about", "Skip to Main Content"], ["https://www.fis.edu/about", "About"], ["https://www.fis.edu/about/who-we-are", "Discover FIS"], ["https://www.fis.edu/about/meet-our-leadership", "Meet Our Leadership"], ["https://www.fis.edu/about/boardoftrustees", "Meet Our Board"], ["https://www.fis.edu/about/where-we-are-headed", "Learn Where We're Headed"], ["https://www.fis.edu/about/safeguarding", "Safeguarding"], ["https://www.fis.edu/about/belonging", "Well-being and Belonging"], ["https://www.fis.edu/about/leaving-a-legacy", "Give to FIS"], ["https://www.fis.edu/about/our-campuses", "Tour Our Campuses"], ["https://www.fis.edu/about", "Aboutexpand this section"], ["https://www.fis.edu/about/who-we-are", "Discover FIS"], ["https://www.fis.edu/about/meet-our-leadership", "Meet Our Leadership"], ["https://www.fis.edu/about/boardoftrustees", "Meet Our Board"], ["https://www.fis.edu/about/where-we-are-headed", "Learn Where We're Headed"], ["https://www.fis.edu/about/safeguarding", "Safeguarding"], ["https://www.fis.edu/about/belonging", "Well-being and Belonging"], ["https://www.fis.edu/about/leaving-a-legacy", "Give to FIS"], ["https://www.fis.edu/about/our-campuses", "Tour Our Campuses"], ["https://www.fis.edu/about/who-we-are", "Discover FIS"], ["https://www.fis.edu/about/meet-our-leadership", "Meet Our Leadership"], ["https://www.fis.edu/about/boardoftrustees", "Meet Our Board"], ["https://www.fis.edu/about/where-we-are-headed",